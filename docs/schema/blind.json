  "$id": "https://github.com/whoAngeel/pokerhub/internal/protocol/blind-payload",
  "properties": {
    "seat": {
      "type": "integer"
    },
    "type": {
      "type": "string"
    },
    "amount": {
      "type": "integer"
    },
    "stack_after": {
      "type": "integer"
    },
    "pot_after": {
      "type": "integer"
    }
  },
